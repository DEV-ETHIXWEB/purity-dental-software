# Copy this file to .env and fill in real values for your environment.
# Never commit a real .env with production secrets.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/purity_dev?schema=public"

# Used to derive additional keyed material if/when the session token scheme
# needs it beyond the current random-token-hash approach (see
# src/lib/auth/tokens.ts). Not strictly required by that scheme today, but
# reserved so a future signed/stateless session format doesn't need a new
# env var. Generate a real value for any non-local environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to an insecure dev-only default (see src/lib/env.ts) if unset,
# so local dev without a .env doesn't hard-fail — production must set this.
SESSION_SECRET="replace-with-a-real-64-char-random-hex-string-in-non-local-envs"

# Optional: used to build absolute password-reset links when the app isn't
# on localhost (see src/lib/actions/password-reset.ts). Defaults to
# http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

