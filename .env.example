# Copy this file to .env and fill in real values for your environment.
# Never commit a real .env with production secrets.
#
# --- Deploy order (once DATABASE_URL below points at a real, reachable
#     Postgres instance) ---
#   1. npm ci
#   2. npx prisma generate            (regenerates src/generated/prisma; also
#                                       runs automatically via the "postinstall"
#                                       step some hosts trigger after npm ci —
#                                       run it explicitly if yours doesn't)
#   3. npx prisma migrate deploy      (applies committed migrations; NOT
#                                       `migrate dev` — that's dev-only and
#                                       will prompt interactively)
#   4. npx prisma db seed             (OPTIONAL — only for a fresh dev/staging
#                                       DB that wants the 5 known dev logins
#                                       below; never run against a real
#                                       production database with real patient
#                                       data)
#   5. npm run build
#   6. npm run start                  (or `node .next/standalone/server.js`
#                                       if you switch next.config.ts's
#                                       `output` to "standalone" — see the
#                                       note in that file for why it isn't
#                                       enabled by default today)
#   7. Confirm GET /api/health returns 200 with "status":"ok" and
#      "database":"ok" — "status":"degraded" means the app is serving but
#      DATABASE_URL is wrong/unreachable from this instance.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/purity_dev?schema=public"

# Used to derive additional keyed material if/when the session token scheme
# needs it beyond the current random-token-hash approach (see
# src/lib/auth/tokens.ts). Not strictly required by that scheme today, but
# reserved so a future signed/stateless session format doesn't need a new
# env var. Generate a real value for any non-local environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to an insecure dev-only default (see src/lib/env.ts) if unset,
# so local dev without a .env doesn't hard-fail — production must set this.
SESSION_SECRET="replace-with-a-real-64-char-random-hex-string-in-non-local-envs"

# Optional: used to build absolute password-reset links when the app isn't
# on localhost (see src/lib/actions/password-reset.ts). Defaults to
# http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

